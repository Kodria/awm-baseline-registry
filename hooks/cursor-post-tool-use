#!/usr/bin/env node
// postToolUse adapter for Cursor.
//
// Installed by the AWM Cursor adapter as <AWM_HOME>/hooks/cursor/post-tool-use.
// Consumes the state/compact-<conversation_id> marker queued by pre-compact:
// on the conversation's first tool call after a compaction it injects the
// output of the sibling `session-start --reanchor` as additional_context.
//
// This runs on EVERY tool call, so the no-marker path is the hot path: it
// reads one directory and exits with no stdin read and no output. Markers and
// claim files older than 24 h are swept; a marker is claimed by an atomic
// rename before the re-anchor is computed, so concurrent tool calls re-anchor
// at most once. Every failure
// ends in silence and exit 0 (verified by tests/cursor-hooks.test.mjs).

'use strict';

const crypto = require('node:crypto');
const fs = require('node:fs');
const path = require('node:path');
const { execFileSync } = require('node:child_process');

// The path the hook was INVOKED through, not its realpath. AWM installs the
// hook as either a copy or a symlink; `__filename` resolves symlinks and would
// point back into the registry, so state/ would land where the sibling hook
// never looks for it. argv[1] preserves the installed location in both cases.
function installedScriptPath() {
    return typeof process.argv[1] === 'string' && process.argv[1].length > 0
        ? process.argv[1]
        : __filename;
}

// Hook stdin is a small JSON envelope. Cap it so a never-EOF flood (/dev/zero)
// cannot grow RSS without bound; anything past the cap is dropped and parsed
// as incomplete JSON (fail-open to {}).
const MAX_STDIN_BYTES = 1024 * 1024;

// Reading fd 0 can raise EAGAIN when the parent handed us a non-blocking pipe;
// that is a "try again", not "no input". Distinguishing it from malformed JSON
// matters: silently degrading loses `conversation_id` and crosses markers.
function readStdin() {
    // Chunks read before an EAGAIN are kept: a writer that holds stdin open
    // (no EOF yet) must not lose the payload it already sent. The attempt
    // counter resets on every successful read so a trickled payload does not
    // burn the budget across chunks.
    const chunks = [];
    let total = 0;
    const buffer = Buffer.alloc(64 * 1024);
    for (let attempt = 0; attempt < 20;) {
        let bytes;
        try {
            bytes = fs.readSync(0, buffer, 0, buffer.length, null);
        } catch (error) {
            if (error.code !== 'EAGAIN') break;
            attempt += 1;
            try {
                // Back off ~10 ms by running a short-lived Node child (one
                // spawn per retry, up to 20), then retry the read.
                execFileSync(process.execPath, ['-e', 'setTimeout(()=>{},10)'], { stdio: 'ignore', killSignal: 'SIGKILL' });
            } catch {
                break;
            }
            continue;
        }
        if (bytes === 0) break; // EOF
        attempt = 0;
        const take = Math.min(bytes, MAX_STDIN_BYTES - total);
        if (take > 0) chunks.push(Buffer.from(buffer.subarray(0, take)));
        total += take;
        if (total >= MAX_STDIN_BYTES) break;
    }
    return Buffer.concat(chunks).toString('utf8');
}

// Cursor owns this payload, but a hook that trusts its shape crashes on a
// stray `null` or `"text"` — both of which are valid JSON. When a truncated
// multi-megabyte tool-call payload fails JSON.parse, pull conversation_id and
// workspace_roots from the leading bytes so the marker claim still works.
function readInput() {
    if (process.stdin.isTTY) return {};
    const raw = readStdin() || '';
    let parsed;
    try {
        parsed = JSON.parse(raw || '{}');
    } catch {
        return extractHookFields(raw);
    }
    return parsed !== null && typeof parsed === 'object' && !Array.isArray(parsed)
        ? parsed
        : extractHookFields(raw);
}

function extractHookFields(raw) {
    const out = {};
    const id = raw.match(/"conversation_id"\s*:\s*"([^"]{1,128})"/);
    if (id) out.conversation_id = id[1];
    const roots = raw.match(/"workspace_roots"\s*:\s*\[([^\]]{0,4096})\]/);
    if (roots) {
        try {
            const list = JSON.parse(`[${roots[1]}]`);
            if (Array.isArray(list)) out.workspace_roots = list;
        } catch {
            // Leave workspace_roots unset; CURSOR_PROJECT_DIR still resolves.
        }
    }
    return out;
}

// One marker per conversation. The id is reduced to [A-Za-z0-9_-] so a hostile
// `conversation_id` (e.g. `../../x`) can never name a path outside state/.
function markerName(input) {
    const id = typeof input.conversation_id === 'string'
        ? input.conversation_id.replace(/[^A-Za-z0-9_-]/g, '').slice(0, 128)
        : '';
    return `compact-${id || 'default'}`;
}

const STALE_MS = 24 * 60 * 60 * 1000;
const REANCHOR_TIMEOUT_MS = 3000;

function main() {
    const dir = path.dirname(installedScriptPath());
    const state = path.join(dir, 'state');
    let names;
    try {
        names = fs.readdirSync(state).filter((name) => name.startsWith('compact-'));
    } catch {
        return;
    }
    // Sweep markers and claim files older than 24 h. With no compact-* entry
    // this loop is empty, so the no-state/empty-state hot path stays one readdir.
    const live = [];
    for (const name of names) {
        const file = path.join(state, name);
        try {
            if (Date.now() - fs.statSync(file).mtimeMs > STALE_MS) fs.unlinkSync(file);
            else live.push(name);
        } catch {
            // Already consumed by a concurrent call.
        }
    }
    // Hot path on every tool call: no marker, no stdin read, no output. Claim
    // files (compact-<id>.claim-...) are not markers — marker names never
    // contain a dot — so a leftover claim does not knock calls off this path.
    // A pending marker of ANOTHER conversation does: only stdin says which
    // conversation this call belongs to, so every tool call pays one stdin
    // read until that marker is consumed or swept as stale.
    if (!live.some((name) => !name.includes('.'))) return;

    const input = readInput();
    const marker = path.join(state, markerName(input));
    // Claim BEFORE injecting: two concurrent tool calls must not both re-anchor.
    // The claim is a rename to a per-process name, not an unlink: on macOS APFS
    // several processes unlinking one path at once can all see success, while
    // exactly one rename of it wins (plan amendment A2). The claim name never
    // equals a marker name, and the stale sweep above removes leftovers.
    const claim = `${marker}.claim-${process.pid}-${crypto.randomBytes(8).toString('hex')}`;
    try {
        fs.renameSync(marker, claim);
    } catch {
        return;
    }
    try {
        fs.unlinkSync(claim);
    } catch {
        // Best-effort: a leftover claim is swept once it is older than 24 h.
    }
    // Forward only the fields session-start needs. Re-piping the whole Cursor
    // tool-call payload can be multi-megabyte; the child then hits the stdin
    // cap, abandons the parse, and the re-anchor is silently lost.
    const forward = {};
    if (typeof input.conversation_id === 'string') forward.conversation_id = input.conversation_id;
    if (Array.isArray(input.workspace_roots)) forward.workspace_roots = input.workspace_roots;
    let text = '';
    try {
        text = execFileSync(process.execPath, [path.join(dir, 'session-start'), '--reanchor'], {
            input: JSON.stringify(forward),
            encoding: 'utf8',
            timeout: REANCHOR_TIMEOUT_MS,
            killSignal: 'SIGKILL',
            stdio: ['pipe', 'pipe', 'ignore'],
        });
    } catch {
        return;
    }
    if (text.trim()) process.stdout.write(`${JSON.stringify({ additional_context: text })}\n`);
}

try {
    main();
} catch {
    // Silence is the correct answer for a tool-call hook that cannot help.
}
