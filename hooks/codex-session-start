#!/usr/bin/env node
// SessionStart adapter for Codex.
//
// Installed by `awm init --agent codex` as ~/.awm/hooks/codex/session-start and
// wired into ~/.codex/hooks.json on the matcher 'startup|resume|clear|compact'.
// It is the deterministic recovery point for those four events: it re-anchors
// the durable, file-derived canonical state (project constitution, active plan
// goal, open plan items, open ledger items) that a fresh, resumed, cleared or
// compacted context does not carry.
//
// Two contracts this file must satisfy, both verified by
// tests/codex-session-start.test.mjs:
//
//   1. stdout is a single JSON object with hookSpecificOutput.additionalContext.
//   2. heartbeat.json, written next to the INSTALLED script, carries
//      { hash, ts } where `hash` is the sha256 of that installed script. `awm
//      hooks status --agent codex` compares it against the file on disk to
//      decide healthy / stale / pending-trust.
//
// Failure-safe by design: every filesystem and subprocess probe degrades to
// "omit that section" rather than throwing. A SessionStart hook that crashes
// takes the whole session's context with it, so silent-in-absence beats loud.

const crypto = require('node:crypto');
const fs = require('node:fs');
const path = require('node:path');
const { execFileSync } = require('node:child_process');

const AWM_DIRECTIVE = 'AWM is active. Load and follow `using-awm` and `development-process` before development work.';

// The path the hook was INVOKED through, not its realpath. AWM installs the
// hook as either a copy or a symlink; `__filename` resolves symlinks and would
// point back into the registry, writing the heartbeat where the CLI never
// looks for it. argv[1] preserves the installed location in both cases.
function installedScriptPath() {
    return typeof process.argv[1] === 'string' && process.argv[1].length > 0
        ? process.argv[1]
        : __filename;
}

// One project file must never dominate a session's context window. Beyond
// these caps the section is truncated with a visible marker rather than
// dropped, so the agent knows to open the file itself.
const MAX_CONSTITUTION_BYTES = 64 * 1024;
const MAX_LINE_CHARS = 500;
const MAX_LEDGER_BYTES = 256 * 1024;
const AWM_TIMEOUT_MS = 2000;

function truncate(text, limit, marker) {
    return text.length > limit ? `${text.slice(0, limit)}\n${marker}` : text;
}

// Reading fd 0 can raise EAGAIN when the parent handed us a non-blocking pipe;
// that is a "try again", not "no input". Distinguishing it from malformed JSON
// matters: silently degrading loses `cwd` and mislabels a compact as a startup.
function readStdin() {
    for (let attempt = 0; attempt < 20; attempt += 1) {
        try {
            return fs.readFileSync(0, 'utf8');
        } catch (error) {
            if (error.code !== 'EAGAIN') return '';
            try {
                // Block briefly without a timer: sleep via a 0-byte read retry.
                execFileSync(process.execPath, ['-e', 'setTimeout(()=>{},10)'], { stdio: 'ignore' });
            } catch {
                return '';
            }
        }
    }
    return '';
}

// Codex owns this payload, but a hook that trusts its shape crashes the whole
// session on a stray `null` or `"text"` — both of which are valid JSON.
function readInput() {
    if (process.stdin.isTTY) return {};
    let parsed;
    try {
        parsed = JSON.parse(readStdin() || '{}');
    } catch {
        return {};
    }
    return parsed !== null && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
}

function readIfPresent(file, limit) {
    try {
        if (fs.statSync(file).size === 0) return '';
        return truncate(fs.readFileSync(file, 'utf8'), limit, '[truncated by AWM — read the file for the rest]');
    } catch {
        return '';
    }
}

// A plan is "done" only when the marker appears as the HTML comment the
// skills actually write. Matching the bare token would also silence any plan
// whose own steps document the marker.
const PLAN_COMPLETE = /<!--\s*awm-(plan|qa)-complete/;
// Design docs are `<topic>-design.md`. Matching the bare word `design` would
// also drop `2026-07-24-redesign-checkout-plan.md`, losing recovery entirely.
const DESIGN_DOC = /-design\.md$/;

// Active plan = most-recently-modified plan (not a design doc) that still has
// open checkboxes and is not marked complete. Deterministic and file-derived,
// mirroring hooks/session-start so both providers re-anchor on the same plan.
function activePlan(cwd) {
    const plansDir = path.join(cwd, 'docs/plans');
    let names;
    try {
        names = fs.readdirSync(plansDir);
    } catch {
        return null;
    }

    const candidates = [];
    for (const name of names) {
        if (!name.endsWith('.md') || DESIGN_DOC.test(name)) continue;
        const file = path.join(plansDir, name);
        try {
            const body = fs.readFileSync(file, 'utf8');
            if (!/^- \[ \]/m.test(body)) continue;
            if (PLAN_COMPLETE.test(body)) continue;
            candidates.push({ file, body, mtime: fs.statSync(file).mtimeMs });
        } catch {
            // Unreadable plan: skip it rather than losing the whole re-anchor.
        }
    }

    candidates.sort((a, b) => b.mtime - a.mtime || a.file.localeCompare(b.file));
    return candidates[0] || null;
}

// Open findings for the current branch, via `awm ledger list`. Absent CLI or
// absent ledger yields no section rather than an error.
// `maxBuffer` is explicit: on the 1 MB default a large ledger throws ENOBUFS,
// which is indistinguishable here from "no ledger" and would drop the section
// silently. `awmReachable` records whether the probe answered at all, so the
// audit write below does not spend a second timeout against a wedged binary.
let awmReachable = true;

function ledgerItems(cwd) {
    try {
        return execFileSync('awm', ['ledger', 'list'], {
            cwd,
            encoding: 'utf8',
            stdio: ['ignore', 'pipe', 'ignore'],
            timeout: AWM_TIMEOUT_MS,
            maxBuffer: MAX_LEDGER_BYTES,
        })
            .split(/\r?\n/)
            .filter(Boolean)
            .slice(0, 8)
            .map((line) => truncate(line, MAX_LINE_CHARS, '[truncated]'));
    } catch (error) {
        if (error.code === 'ETIMEDOUT' || error.signal === 'SIGTERM') awmReachable = false;
        return [];
    }
}

// Audit trail for genuine compaction boundaries only — same entry the Claude
// hook records, so the ledger reads identically across providers.
function recordCompactionRecovery(cwd, event) {
    if (event !== 'compact' || !awmReachable) return;
    try {
        execFileSync('awm', [
            'ledger', 'add',
            '--phase', 'compaction-recovery',
            '--source-skill', 'context-compaction-recovery',
            '--polarity', 'finding',
            '--class', 'proceso',
            '--signature', 'compaction-reanchor',
            '--severity', 'info',
            '--desc', 're-anchored active plan + open items after compaction',
        ], { cwd, stdio: 'ignore', timeout: AWM_TIMEOUT_MS });
    } catch {
        // Best-effort: no awm on PATH, or no ledger for this branch.
    }
}

function buildContext(cwd, event) {
    const sections = [AWM_DIRECTIVE];

    const constitution = readIfPresent(path.join(cwd, 'CONSTITUTION.md'), MAX_CONSTITUTION_BYTES);
    if (constitution.trim()) {
        sections.push(`## Project Constitution\n\n${constitution.trim()}`);
    }

    const plan = activePlan(cwd);
    if (plan) {
        // Leading `>`/whitespace tolerated: plans written by `writing-plans`
        // put the goal inside a blockquote, and the Claude hook's unanchored
        // grep finds it there. An anchored match would silently fall through
        // to the H1 and re-anchor Codex on a different goal than Claude.
        const goal = plan.body.match(/^[>\s]*\*\*Goal:\*\*\s*(.+)$/m)?.[1]
            || plan.body.match(/^#\s+(.+)$/m)?.[1]
            || path.basename(plan.file);
        const openItems = (plan.body.match(/^- \[ \].+$/gm) || [])
            .slice(0, 8)
            .map((item) => truncate(item, MAX_LINE_CHARS, '[truncated]'));
        const ledger = ledgerItems(cwd);

        sections.push([
            '## Re-anchor (startup, resume, clear, compact)',
            `Active plan: ${path.basename(plan.file)}`,
            `Goal: ${goal}`,
            ...(openItems.length ? ['Open plan items:', ...openItems] : []),
            ...(ledger.length ? ['Open ledger items:', ...ledger] : []),
        ].join('\n'));

        recordCompactionRecovery(cwd, event);
    }

    return sections.join('\n\n');
}

function writeHeartbeat(scriptPath, event) {
    try {
        const heartbeat = {
            version: 1,
            // Field names are the CLI's contract — see computeCodexTrust in
            // cli/src/commands/hooks/codex.ts. Renaming `hash` makes every
            // installation report `stale`.
            hash: crypto.createHash('sha256').update(fs.readFileSync(scriptPath)).digest('hex'),
            ts: new Date().toISOString(),
            event,
        };
        const file = path.join(path.dirname(scriptPath), 'heartbeat.json');
        const temp = `${file}.${process.pid}.tmp`;
        try {
            fs.writeFileSync(temp, `${JSON.stringify(heartbeat, null, 2)}\n`, { mode: 0o600 });
            fs.renameSync(temp, file);
        } catch (error) {
            // Leave no orphan behind: a failing rename otherwise drops one
            // stale .tmp into the install directory on every single session.
            try { fs.unlinkSync(temp); } catch { /* already gone */ }
            throw error;
        }
    } catch {
        // A read-only or missing hooks directory must not break the session;
        // the CLI reports pending-trust, which is the honest observed state.
    }
}

// The directory the session launched from may already be gone, in which case
// `process.cwd()` throws ENOENT. Resolving the supplied cwd FIRST means a
// perfectly valid payload still works from a deleted launch directory.
function resolveCwd(input) {
    if (typeof input.cwd === 'string' && input.cwd) {
        try {
            if (fs.statSync(input.cwd).isDirectory()) return input.cwd;
        } catch {
            // Fall through to the process's own directory.
        }
    }
    try {
        return process.cwd();
    } catch {
        return null;
    }
}

function main() {
    const input = readInput();
    const event = typeof input.source === 'string' && input.source ? input.source : 'startup';

    const cwd = resolveCwd(input);
    const scriptPath = installedScriptPath();
    // With no usable directory there is nothing to re-anchor against, but the
    // session still gets the AWM directive rather than an empty context.
    const additionalContext = cwd === null ? AWM_DIRECTIVE : buildContext(cwd, event);
    writeHeartbeat(scriptPath, event);

    process.stdout.write(`${JSON.stringify({
        hookSpecificOutput: {
            hookEventName: 'SessionStart',
            additionalContext,
        },
    })}\n`);
}

main();
