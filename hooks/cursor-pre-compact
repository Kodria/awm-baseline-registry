#!/usr/bin/env node
// preCompact adapter for Cursor.
//
// Installed by the AWM Cursor adapter as <AWM_HOME>/hooks/cursor/pre-compact.
// Cursor's preCompact is observational: it cannot inject context. So this hook
// only QUEUES a re-anchor: it writes state/compact-<conversation_id> next to
// the installed script, and the sibling post-tool-use hook consumes that
// marker on the conversation's next tool call, injecting
// `session-start --reanchor` as additional_context.
//
// Contract verified by tests/cursor-hooks.test.mjs: stdout is exactly `{}`,
// the exit code is 0, and the marker is written even when `awm` is missing,
// failing or hung. The `awm ledger add` audit entry is best-effort.

'use strict';

const fs = require('node:fs');
const path = require('node:path');
const { execFileSync } = require('node:child_process');

// The path the hook was INVOKED through, not its realpath. AWM installs the
// hook as either a copy or a symlink; `__filename` resolves symlinks and would
// point back into the registry, so state/ would land where the sibling hook
// never looks for it. argv[1] preserves the installed location in both cases.
function installedScriptPath() {
    return typeof process.argv[1] === 'string' && process.argv[1].length > 0
        ? process.argv[1]
        : __filename;
}

// Reading fd 0 can raise EAGAIN when the parent handed us a non-blocking pipe;
// that is a "try again", not "no input". Distinguishing it from malformed JSON
// matters: silently degrading loses `conversation_id` and crosses markers.
function readStdin() {
    for (let attempt = 0; attempt < 20; attempt += 1) {
        try {
            return fs.readFileSync(0, 'utf8');
        } catch (error) {
            if (error.code !== 'EAGAIN') return '';
            try {
                // Block briefly without a timer: sleep via a 0-byte read retry.
                execFileSync(process.execPath, ['-e', 'setTimeout(()=>{},10)'], { stdio: 'ignore' });
            } catch {
                return '';
            }
        }
    }
    return '';
}

// Cursor owns this payload, but a hook that trusts its shape crashes on a
// stray `null` or `"text"` — both of which are valid JSON.
function readInput() {
    if (process.stdin.isTTY) return {};
    let parsed;
    try {
        parsed = JSON.parse(readStdin() || '{}');
    } catch {
        return {};
    }
    return parsed !== null && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
}

// Cursor passes no cwd. The env var is the documented project root; the first
// workspace root covers hosts that omit it.
function resolveProject(input) {
    const roots = Array.isArray(input.workspace_roots) ? input.workspace_roots : [];
    for (const candidate of [process.env.CURSOR_PROJECT_DIR, roots[0]]) {
        if (typeof candidate !== 'string' || !candidate) continue;
        try {
            if (fs.statSync(candidate).isDirectory()) return candidate;
        } catch {
            // Try the next candidate.
        }
    }
    try {
        return process.cwd();
    } catch {
        return null;
    }
}

const AWM_TIMEOUT_MS = 2000;

// One marker per conversation. The id is reduced to [A-Za-z0-9_-] so a hostile
// `conversation_id` (e.g. `../../x`) can never name a path outside state/.
function markerName(input) {
    const id = typeof input.conversation_id === 'string'
        ? input.conversation_id.replace(/[^A-Za-z0-9_-]/g, '').slice(0, 128)
        : '';
    return `compact-${id || 'default'}`;
}

function main() {
    const input = readInput();
    try {
        const state = path.join(path.dirname(installedScriptPath()), 'state');
        fs.mkdirSync(state, { recursive: true, mode: 0o700 });
        fs.writeFileSync(path.join(state, markerName(input)), `${new Date().toISOString()}\n`, { mode: 0o600 });
    } catch {
        // No marker means no re-anchor; the session itself is unaffected.
    }
    const cwd = resolveProject(input);
    if (cwd !== null) {
        try {
            execFileSync('awm', ['ledger', 'add', '--phase', 'compaction-recovery',
                '--source-skill', 'context-compaction-recovery', '--polarity', 'finding',
                '--class', 'proceso', '--signature', 'compaction-reanchor', '--severity', 'info',
                '--desc', 'Cursor compacted the context; re-anchor queued for the next tool call'],
            { cwd, stdio: 'ignore', timeout: AWM_TIMEOUT_MS });
        } catch {
            // Best-effort audit trail, same as the Claude and Codex hooks.
        }
    }
    process.stdout.write('{}\n');
}

try {
    main();
} catch {
    process.stdout.write('{}\n');
}
