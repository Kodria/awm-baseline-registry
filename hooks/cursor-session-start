#!/usr/bin/env node
// sessionStart adapter for Cursor.
//
// Installed by the AWM Cursor adapter as <AWM_HOME>/hooks/cursor/session-start,
// next to the composed `using-awm.md` payload that adapter writes. Cursor fires
// sessionStart only for NEW conversations, so this hook delivers the initial
// feedforward context: the using-awm guide, the project constitution and a
// snapshot of the active plan. Compaction recovery lives in pre-compact /
// post-tool-use, which call `session-start --reanchor` for the re-anchor text.
//
// Cursor passes JSON on stdin (conversation_id, hook_event_name,
// workspace_roots, cursor_version) but no `cwd`; the project root comes from
// CURSOR_PROJECT_DIR, then workspace_roots[0], then the process cwd.
//
// Contracts verified by tests/cursor-hooks.test.mjs:
//
//   1. With no arguments, stdout is a single JSON object
//      {"additional_context": string} of at most 24 KiB (UTF-8 bytes).
//   2. heartbeat.json, written next to the INSTALLED script, carries
//      { version, hash, ts, event } where `hash` is the sha256 of that
//      installed script and `event` is `sessionStart`.
//   3. `--reanchor` prints the plain-text re-anchor section (possibly empty),
//      at most 4 KiB, and writes no heartbeat.
//
// Failure-safe by design: every filesystem and subprocess probe degrades to
// "omit that section" rather than throwing. A session hook that crashes takes
// the whole session's context with it, so silent-in-absence beats loud.

const crypto = require('node:crypto');
const fs = require('node:fs');
const path = require('node:path');
const { execFileSync } = require('node:child_process');

const AWM_DIRECTIVE = 'AWM is active. Load and follow `using-awm` and `development-process` before development work.';

// The path the hook was INVOKED through, not its realpath. AWM installs the
// hook as either a copy or a symlink; `__filename` resolves symlinks and would
// point back into the registry, writing the heartbeat where the CLI never
// looks for it. argv[1] preserves the installed location in both cases.
function installedScriptPath() {
    return typeof process.argv[1] === 'string' && process.argv[1].length > 0
        ? process.argv[1]
        : __filename;
}

// One project file must never dominate a session's context window. Beyond
// these caps the section is truncated with a visible marker rather than
// dropped, so the agent knows to open the file itself.
const MAX_CONSTITUTION_BYTES = 64 * 1024;
const MAX_LINE_CHARS = 500;
const MAX_LEDGER_BYTES = 256 * 1024;
const AWM_TIMEOUT_MS = 2000;

function truncate(text, limit, marker) {
    return text.length > limit ? `${text.slice(0, limit)}\n${marker}` : text;
}

// Reading fd 0 can raise EAGAIN when the parent handed us a non-blocking pipe;
// that is a "try again", not "no input". Distinguishing it from malformed JSON
// matters: silently degrading loses `cwd` and mislabels a compact as a startup.
function readStdin() {
    for (let attempt = 0; attempt < 20; attempt += 1) {
        try {
            return fs.readFileSync(0, 'utf8');
        } catch (error) {
            if (error.code !== 'EAGAIN') return '';
            try {
                // Block briefly without a timer: sleep via a 0-byte read retry.
                execFileSync(process.execPath, ['-e', 'setTimeout(()=>{},10)'], { stdio: 'ignore' });
            } catch {
                return '';
            }
        }
    }
    return '';
}

// Codex owns this payload, but a hook that trusts its shape crashes the whole
// session on a stray `null` or `"text"` — both of which are valid JSON.
function readInput() {
    if (process.stdin.isTTY) return {};
    let parsed;
    try {
        parsed = JSON.parse(readStdin() || '{}');
    } catch {
        return {};
    }
    return parsed !== null && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
}

function readIfPresent(file, limit) {
    try {
        if (fs.statSync(file).size === 0) return '';
        return truncate(fs.readFileSync(file, 'utf8'), limit, '[truncated by AWM — read the file for the rest]');
    } catch {
        return '';
    }
}

// A plan is "done" only when the marker appears as the HTML comment the
// skills actually write. Matching the bare token would also silence any plan
// whose own steps document the marker.
const PLAN_COMPLETE = /<!--\s*awm-(plan|qa)-complete/;
// Design docs are `<topic>-design.md`. Matching the bare word `design` would
// also drop `2026-07-24-redesign-checkout-plan.md`, losing recovery entirely.
const DESIGN_DOC = /-design\.md$/;
// A plan is a regular file of at most this size. Anything else (a symlink to
// /dev/zero, a FIFO with no writer, a huge file) is skipped unread: reading it
// would hang or bloat the session start.
const MAX_PLAN_BYTES = 1024 * 1024;

// Active plan = most-recently-modified plan (not a design doc) that still has
// open checkboxes and is not marked complete. Deterministic and file-derived,
// mirroring hooks/session-start so both providers re-anchor on the same plan.
function activePlan(cwd) {
    const plansDir = path.join(cwd, 'docs/plans');
    let names;
    try {
        names = fs.readdirSync(plansDir);
    } catch {
        return null;
    }

    const candidates = [];
    for (const name of names) {
        // Dot-prefixed names are skipped, as the bash hook's `*.md` glob does.
        if (name.startsWith('.') || !name.endsWith('.md') || DESIGN_DOC.test(name)) continue;
        const file = path.join(plansDir, name);
        try {
            // statSync follows symlinks, so a link to a device is caught here.
            // bigint: mtimeNs keeps the nanoseconds that `ls -t` orders by;
            // float mtimeMs merges mtimes less than ~240 ns apart.
            const stat = fs.statSync(file, { bigint: true });
            if (!stat.isFile() || stat.size > BigInt(MAX_PLAN_BYTES)) continue;
            const body = fs.readFileSync(file, 'utf8');
            if (!/^- \[ \]/m.test(body)) continue;
            if (PLAN_COMPLETE.test(body)) continue;
            candidates.push({ file, body, mtime: stat.mtimeNs });
        } catch {
            // Unreadable plan: skip it rather than losing the whole re-anchor.
        }
    }

    // Newest first. Ties break in UTF-8 byte order, as `LC_ALL=C ls -t` does
    // in hooks/session-start. localeCompare disagrees on case (`B-plan.md` vs
    // `a-plan.md`) and `<` compares UTF-16 code units (U+1F600 vs U+FF01).
    candidates.sort((a, b) => (b.mtime > a.mtime ? 1 : b.mtime < a.mtime ? -1 : 0)
        || Buffer.compare(Buffer.from(a.file), Buffer.from(b.file)));
    return candidates[0] || null;
}

// Open findings for the current branch, via `awm ledger list`, which prints
// the branch ledger as a pretty-printed JSON array of entries
// {ts, branch, phase, source_skill, polarity, class, signature, severity,
// desc, ref?}, oldest first. Only findings are open items (wins are not),
// minus this hook family's own `compaction-reanchor` audit entries, which
// pre-compact records on every compaction and would otherwise crowd out real
// findings. The newest 8 are rendered, newest first, one line each. Absent
// CLI, absent ledger, non-JSON or non-array output yields no section rather
// than an error.
// `maxBuffer` is explicit: on the 1 MB default a large ledger throws ENOBUFS,
// which is indistinguishable here from "no ledger" and would drop the section
// silently.
const COMPACTION_AUDIT_SIGNATURE = 'compaction-reanchor';

function ledgerItems(cwd) {
    let entries;
    try {
        entries = JSON.parse(execFileSync('awm', ['ledger', 'list'], {
            cwd,
            encoding: 'utf8',
            stdio: ['ignore', 'pipe', 'ignore'],
            timeout: AWM_TIMEOUT_MS,
            maxBuffer: MAX_LEDGER_BYTES,
        }));
    } catch {
        return [];
    }
    if (!Array.isArray(entries)) return [];
    return entries
        .filter((entry) => entry !== null && typeof entry === 'object'
            && entry.polarity === 'finding' && entry.signature !== COMPACTION_AUDIT_SIGNATURE)
        .slice(-8)
        .reverse()
        .map((entry) => truncate(`- [${entry.severity}] ${entry.signature}: ${entry.desc}`, MAX_LINE_CHARS, '[truncated]'));
}

function writeHeartbeat(scriptPath, event) {
    try {
        const heartbeat = {
            version: 1,
            // Field names are the CLI's contract — see computeCodexTrust in
            // cli/src/commands/hooks/codex.ts. Renaming `hash` makes every
            // installation report `stale`.
            hash: crypto.createHash('sha256').update(fs.readFileSync(scriptPath)).digest('hex'),
            ts: new Date().toISOString(),
            event,
        };
        const file = path.join(path.dirname(scriptPath), 'heartbeat.json');
        const temp = `${file}.${process.pid}.tmp`;
        try {
            fs.writeFileSync(temp, `${JSON.stringify(heartbeat, null, 2)}\n`, { mode: 0o600 });
            fs.renameSync(temp, file);
        } catch (error) {
            // Leave no orphan behind: a failing rename otherwise drops one
            // stale .tmp into the install directory on every single session.
            try { fs.unlinkSync(temp); } catch { /* already gone */ }
            throw error;
        }
    } catch {
        // A read-only or missing hooks directory must not break the session;
        // the CLI reports pending-trust, which is the honest observed state.
    }
}

const MAX_SESSION_BYTES = 24 * 1024;
const MAX_REANCHOR_BYTES = 4 * 1024;
const MAX_USING_AWM_BYTES = 16 * 1024;
const SNAPSHOT_HEADING = '## Plan snapshot (taken at session start)\nThis is a snapshot; re-read the plan file for the current state.';
const REANCHOR_HEADING = '## Re-anchor (post-compaction)\nState recomputed after the context was compacted.';

// `truncate` above caps UTF-16 characters, and appends its marker past the
// limit. The R5 budgets are UTF-8 bytes of the whole payload, marker included,
// so they get their own cap. It cuts on a character boundary: a split
// multi-byte sequence would decode to U+FFFD in the agent's context.
function truncateBytes(text, limit, marker) {
    const bytes = Buffer.from(text, 'utf8');
    if (bytes.length <= limit) return text;
    const suffix = `\n${marker}`;
    let end = Math.max(0, limit - Buffer.byteLength(suffix, 'utf8'));
    // Back up over UTF-8 continuation bytes (10xxxxxx) to a character start.
    while (end > 0 && (bytes[end] & 0xc0) === 0x80) end -= 1;
    return `${bytes.subarray(0, end).toString('utf8')}${suffix}`;
}

// Every probe is optional context: a failure drops that section, never the session.
function safe(probe) {
    try {
        return probe() || '';
    } catch {
        return '';
    }
}

// Cursor passes no cwd. The env var is the documented project root; the first
// workspace root covers hosts that omit it.
function resolveProject(input) {
    const roots = Array.isArray(input.workspace_roots) ? input.workspace_roots : [];
    for (const candidate of [process.env.CURSOR_PROJECT_DIR, roots[0]]) {
        if (typeof candidate !== 'string' || !candidate) continue;
        try {
            if (fs.statSync(candidate).isDirectory()) return candidate;
        } catch {
            // Try the next candidate.
        }
    }
    try {
        return process.cwd();
    } catch {
        return null;
    }
}

// Another provider (e.g. Copilot) may already carry the full using-awm body in
// the project's managed AGENTS.md block; delivering it twice costs tokens.
function agentsBlockHasUsingAwm(cwd) {
    const text = readIfPresent(path.join(cwd, 'AGENTS.md'), MAX_CONSTITUTION_BYTES);
    const start = text.indexOf('<!-- AWM:START');
    const end = start === -1 ? -1 : text.indexOf('<!-- AWM:END', start);
    return end !== -1 && /^# Using AWM\s*$/m.test(text.slice(start, end));
}

function usingAwm(scriptPath, cwd) {
    if (cwd !== null && safe(() => agentsBlockHasUsingAwm(cwd))) return '';
    // readIfPresent caps characters; a multibyte guide could still weigh up to
    // ~3x MAX_USING_AWM_BYTES and starve the constitution and the plan snapshot
    // of the session budget, so the guide is capped again in UTF-8 bytes.
    const body = safe(() => truncateBytes(
        readIfPresent(path.join(path.dirname(scriptPath), 'using-awm.md'), MAX_USING_AWM_BYTES).trim(),
        MAX_USING_AWM_BYTES,
        '[truncated by AWM — read the using-awm skill for the rest]',
    ));
    return body || AWM_DIRECTIVE;
}

function reanchorSection(cwd, heading) {
    const plan = activePlan(cwd);
    if (!plan) return '';
    // `[> \t]` and `[ \t]`, not `\s`: an empty `**Goal:**` line must fall
    // through to the H1 instead of capturing the next line.
    const goal = plan.body.match(/^[> \t]*\*\*Goal:\*\*[ \t]*(\S.*)$/m)?.[1]
        || plan.body.match(/^#\s+(.+)$/m)?.[1]
        || path.basename(plan.file);
    const openItems = (plan.body.match(/^- \[ \].+$/gm) || [])
        .slice(0, 8)
        .map((item) => truncate(item, MAX_LINE_CHARS, '[truncated]'));
    const ledger = safe(() => ledgerItems(cwd)) || [];
    return truncateBytes([
        heading,
        `Active plan: ${path.basename(plan.file)}`,
        `Goal: ${goal}`,
        ...(openItems.length ? ['Open plan items:', ...openItems] : []),
        ...(ledger.length ? ['Open ledger items:', ...ledger] : []),
    ].join('\n'), MAX_REANCHOR_BYTES, '[truncated by AWM — re-read the plan]');
}

const SECTION_SEPARATOR = '\n\n';
const CONSTITUTION_HEADING = '## Project Constitution\n\n';
const CONSTITUTION_MARKER = '[truncated by AWM — read CONSTITUTION.md for the rest]';

// The budget is spent on the constitution last: the guide and the plan
// snapshot (itself capped at 4 KiB) are computed first, and the constitution
// is cut to the bytes they leave, so an oversized constitution can never push
// the snapshot out. The final whole-payload cap stays as a safety net.
function buildContext(scriptPath, cwd) {
    const guide = usingAwm(scriptPath, cwd);
    let constitution = '';
    let snapshot = '';
    if (cwd !== null) {
        constitution = safe(() => readIfPresent(path.join(cwd, 'CONSTITUTION.md'), MAX_CONSTITUTION_BYTES)).trim();
        snapshot = safe(() => reanchorSection(cwd, SNAPSHOT_HEADING));
    }
    const fixed = [guide, snapshot].filter(Boolean);
    let constitutionSection = '';
    if (constitution) {
        const used = fixed.reduce((total, section) => total + Buffer.byteLength(section, 'utf8'), 0)
            + Buffer.byteLength(SECTION_SEPARATOR, 'utf8') * fixed.length
            + Buffer.byteLength(CONSTITUTION_HEADING, 'utf8');
        const room = MAX_SESSION_BYTES - used;
        // Only worth a section if more than the marker itself fits.
        if (room > Buffer.byteLength(`\n${CONSTITUTION_MARKER}`, 'utf8')) {
            constitutionSection = `${CONSTITUTION_HEADING}${truncateBytes(constitution, room, CONSTITUTION_MARKER)}`;
        }
    }
    const sections = [guide, constitutionSection, snapshot].filter(Boolean);
    return truncateBytes(sections.join(SECTION_SEPARATOR), MAX_SESSION_BYTES, '[truncated by AWM — read the files for the rest]');
}

function main() {
    const scriptPath = installedScriptPath();
    const input = readInput();
    const cwd = resolveProject(input);
    if (process.argv.includes('--reanchor')) {
        process.stdout.write(cwd === null ? '' : safe(() => reanchorSection(cwd, REANCHOR_HEADING)));
        return;
    }
    const additionalContext = safe(() => buildContext(scriptPath, cwd)) || AWM_DIRECTIVE;
    writeHeartbeat(scriptPath, 'sessionStart');
    process.stdout.write(`${JSON.stringify({ additional_context: additionalContext })}\n`);
}

try {
    main();
} catch {
    // Last line of fail-open: a valid, empty answer and exit 0.
    if (!process.argv.includes('--reanchor')) process.stdout.write('{}\n');
}
