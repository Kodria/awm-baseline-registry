{
  "name": "generic",
  "description": "Generic sensor pack — Semgrep only, works with any language",
  "detects": [],
  "sensors": {
    "security": {
      "fast": false,
      "defaultCmd": "semgrep --config .semgrep.awm.yml --json .",
      "changedCmd": "semgrep --config .semgrep.awm.yml --json {files}",
      "configFile": ".semgrep.awm.yml",
      "formatter": "semgrep"
    },
    "context-budget": {
      "fast": true,
      "defaultCmd": "node awm-context-budget.cjs",
      "configFile": "awm-context-budget.cjs",
      "formatter": "generic"
    }
  }
}
