{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awm.dev/schemas/sensor-pack-v2.json",
  "title": "AWM sensor pack v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "description", "detects", "sensors", "coverage"],
  "properties": {
    "schemaVersion": { "const": 2 }, "name": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/text" },
    "detects": { "$ref": "#/$defs/nonemptyTextArray" },
    "sensors": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/sensor" }, "propertyNames": { "$ref": "#/$defs/id" } },
    "coverage": { "$ref": "#/$defs/coverage" },
    "hardening": { "$ref": "#/$defs/hardening" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$" },
    "nonemptyTextArray": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
    "asset": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*(?:^|/)(?:/|$))[^\\u0000\\r\\n]+$" },
    "npmExecutable": { "pattern": "^[nN][pP][mM](?:\\.[eE][xX][eE])?$" },
    "pnpmExecutable": { "pattern": "^[pP][nN][pP][mM](?:\\.[eE][xX][eE])?$" },
    "yarnExecutable": { "pattern": "^[yY][aA][rR][nN](?:\\.[eE][xX][eE])?$" },
    "bunExecutable": { "pattern": "^[bB][uU][nN](?:\\.[eE][xX][eE])?$" },
    "sensor": { "type": "object", "additionalProperties": false, "required": ["applicability", "variants"], "properties": { "fast": { "type": "boolean" }, "timeout": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "applicability": { "$ref": "#/$defs/applicability" }, "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/variant" } } } },
    "applicability": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "allFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } }, "anyFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } }, "kind": { "$ref": "#/$defs/text" } } },
    "variant": { "type": "object", "additionalProperties": false, "required": ["id", "priority", "certifiedRange", "command", "assets", "formatter"], "properties": { "id": { "$ref": "#/$defs/id" }, "priority": { "type": "integer" }, "requirements": { "$ref": "#/$defs/requirements" }, "certifiedRange": { "$ref": "#/$defs/text" }, "command": { "$ref": "#/$defs/structuredCommand" }, "changedCommand": { "$ref": "#/$defs/structuredCommand" }, "assets": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/asset" } }, "formatter": { "$ref": "#/$defs/text" }, "probe": { "$ref": "#/$defs/probe" }, "policyRef": { "const": "shared/semgrep-policy.json" } }, "allOf": [{ "if": { "required": ["changedCommand"] }, "then": { "properties": { "changedCommand": { "required": ["fileInput"] } } } }], "oneOf": [{ "required": ["requirements", "probe"], "not": { "required": ["policyRef"] } }, { "required": ["policyRef"], "not": { "anyOf": [{ "required": ["requirements"] }, { "required": ["probe"] }] } }] },
    "requirements": { "type": "object", "additionalProperties": false, "required": ["tool", "toolRange", "runtime", "runtimeRange"], "properties": { "tool": { "$ref": "#/$defs/text" }, "toolRange": { "$ref": "#/$defs/text" }, "runtime": { "$ref": "#/$defs/text" }, "runtimeRange": { "$ref": "#/$defs/text" }, "configFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } }, "packageJsonFields": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" } } } },
"structuredCommand": { "type": "object", "additionalProperties": false, "required": ["executable", "resolution", "args"], "properties": { "executable": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "not": { "pattern": "^(?:[sS][hH]|[bB][aA][sS][hH]|[cC][mM][dD]|[pP][oO][wW][eE][rR][sS][hH][eE][lL][lL])(?:\\.[eE][xX][eE])?$" } }, "resolution": { "enum": ["node-modules-bin", "python-environment", "path"] }, "args": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/commandArg" } }, "packageManager": { "anyOf": [{ "$ref": "#/$defs/npmExecutable" }, { "$ref": "#/$defs/pnpmExecutable" }, { "$ref": "#/$defs/yarnExecutable" }, { "$ref": "#/$defs/bunExecutable" }] }, "environment": { "type": "object", "additionalProperties": false, "required": ["ESLINT_USE_FLAT_CONFIG"], "properties": { "ESLINT_USE_FLAT_CONFIG": { "enum": ["true", "false"] } } }, "fileInput": { "type": "object", "additionalProperties": false, "required": ["placeholder", "extensions"], "properties": { "placeholder": { "const": "{files}" }, "extensions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" } } } } }, "allOf": [{ "if": { "properties": { "executable": { "$ref": "#/$defs/npmExecutable" } } }, "then": { "required": ["packageManager"], "properties": { "packageManager": { "$ref": "#/$defs/npmExecutable" } } } }, { "if": { "properties": { "executable": { "$ref": "#/$defs/pnpmExecutable" } } }, "then": { "required": ["packageManager"], "properties": { "packageManager": { "$ref": "#/$defs/pnpmExecutable" } } } }, { "if": { "properties": { "executable": { "$ref": "#/$defs/yarnExecutable" } } }, "then": { "required": ["packageManager"], "properties": { "packageManager": { "$ref": "#/$defs/yarnExecutable" } } } }, { "if": { "properties": { "executable": { "$ref": "#/$defs/bunExecutable" } } }, "then": { "required": ["packageManager"], "properties": { "packageManager": { "$ref": "#/$defs/bunExecutable" } } } }, { "if": { "required": ["packageManager"], "properties": { "packageManager": { "$ref": "#/$defs/npmExecutable" } } }, "then": { "properties": { "executable": { "$ref": "#/$defs/npmExecutable" } } } }, { "if": { "required": ["packageManager"], "properties": { "packageManager": { "$ref": "#/$defs/pnpmExecutable" } } }, "then": { "properties": { "executable": { "$ref": "#/$defs/pnpmExecutable" } } } }, { "if": { "required": ["packageManager"], "properties": { "packageManager": { "$ref": "#/$defs/yarnExecutable" } } }, "then": { "properties": { "executable": { "$ref": "#/$defs/yarnExecutable" } } } }, { "if": { "required": ["packageManager"], "properties": { "packageManager": { "$ref": "#/$defs/bunExecutable" } } }, "then": { "properties": { "executable": { "$ref": "#/$defs/bunExecutable" } } } }, { "if": { "required": ["fileInput"] }, "then": { "properties": { "args": { "contains": { "const": "{files}" }, "minContains": 1, "maxContains": 1 } } } }, { "if": { "properties": { "args": { "contains": { "const": "{files}" } } } }, "then": { "required": ["fileInput"] } }] },
    "commandArg": { "allOf": [{ "$ref": "#/$defs/text" }, { "pattern": "^(?:[^\\{]|\\{(?!files\\}))*$|^\\{files\\}$" }] },
    "probe": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["version", "eslint-print-config", "typescript-show-config", "semgrep-validate", "package-script-present", "config-present"] } } },
    "hardening": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["assets"], "properties": { "assets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/asset" } } } }, "propertyNames": { "$ref": "#/$defs/id" } },
    "coverage": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "classes"], "properties": { "schemaVersion": { "const": 1 }, "classes": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/coverageClass" }, "propertyNames": { "$ref": "#/$defs/id" } } } },
    "coverageClass": { "type": "object", "additionalProperties": false, "required": ["description", "detectors", "remedy"], "properties": { "description": { "$ref": "#/$defs/text" }, "detectors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/coverageDetector" } }, "remedy": { "$ref": "#/$defs/remedy" } } },
    "coverageDetector": { "type": "object", "additionalProperties": false, "required": ["sensor"], "properties": { "sensor": { "$ref": "#/$defs/id" }, "evidence": { "$ref": "#/$defs/coverageEvidence" } } },
    "coverageEvidence": { "type": "object", "additionalProperties": false, "properties": { "commandIncludes": { "$ref": "#/$defs/nonemptyTextArray" }, "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/coverageFile" } } } },
    "coverageFile": { "type": "object", "additionalProperties": false, "required": ["path", "containsAll"], "properties": { "path": { "enum": ["eslint.config.awm.mjs", "eslint.config.js", "eslint.config.mjs", "eslint.config.cjs", "eslint.config.ts", "eslint.config.mts", "eslint.config.cts", ".semgrep.awm.yml", ".dep-cruiser.awm.js"] }, "containsAll": { "type": "array", "items": { "$ref": "#/$defs/text" } } } },
    "remedy": { "type": "object", "additionalProperties": false, "required": ["summary", "command"], "properties": { "summary": { "$ref": "#/$defs/text" }, "command": { "$ref": "#/$defs/text" } } }
  }
}
