# Running hooks/codex-session-start directly from the checkout (while developing
# it, or from a review agent) drops a heartbeat beside the script. It is runtime
# state of one machine; committing it would ship a bogus trust record to every
# consumer of the registry tag.
hooks/heartbeat.json
hooks/heartbeat.json.*.tmp
.claude/skills/
.claude/agents/
.agents/skills/
.codex/
